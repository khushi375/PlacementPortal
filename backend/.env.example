NODE_ENV=development
PORT=4000
# For local MongoDB: mongodb://127.0.0.1:27017/placement_portal
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/placement_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/placement_portal
FRONTEND_ORIGIN=http://localhost:5173
# Firebase (optional - required for authentication)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Cloudinary (optional - required for file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# AI/Gemini (optional - required for AI coaching)
AI_PROVIDER=GEMINI
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
